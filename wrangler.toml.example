name = "partial-existence-backend"
pages_build_output_dir = "public"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

[[d1_databases]]
binding = "DB"
database_name = "partial-existence-db"
database_id = "<YOUR_D1_DATABASE_ID>"

[vars]
ALLOWED_ORIGINS = "https://kishlay-at-code.github.io,http://localhost:5173,http://127.0.0.1:5173"
WEBSITE_ID = "partial-existence"
